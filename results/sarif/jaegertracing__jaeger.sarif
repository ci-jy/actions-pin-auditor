{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "actpin",
     "version": "0.1.0",
     "informationUri": "https://github.com/",
     "rules": [
      {
       "id": "APN001",
       "name": "unpinned-direct",
       "shortDescription": {
        "text": "Action reference in this repository is not pinned to a full commit SHA"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN002",
       "name": "unpinned-transitive",
       "shortDescription": {
        "text": "A pinned action or reusable workflow pulls in an unpinned action"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN003",
       "name": "impostor-commit",
       "shortDescription": {
        "text": "Pinned SHA is not reachable from any branch or tag of the upstream repository"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN004",
       "name": "tag-moved",
       "shortDescription": {
        "text": "A referenced tag now points at a different commit"
       },
       "defaultConfiguration": {
        "level": "warning"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0` uses a mutable tag reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/detect-workflow-js@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/detect-workflow-js@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/generate-builder@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/generate-builder@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/secure-download-artifact@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/secure-download-artifact@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/secure-builder-checkout@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/secure-builder-checkout@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`docker://ghcr.io/ossf/scorecard-action:v2.4.4` (docker-tag) is pulled in transitively via .github/workflows/scorecard.yml -> ossf/scorecard-action@2d1146689b8cda280b9bc96326124645441f03bc -> docker://ghcr.io/ossf/scorecard-action:v2.4.4. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/scorecard.yml"
        },
        "region": {
         "startLine": 48
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`Wandalen/wretry.action@v3.8.0_js_action` (tag) is pulled in transitively via .github/workflows/ci-e2e-badger.yaml -> ./.github/actions/upload-codecov -> Wandalen/wretry.action@e68c23e6309f2871ca8ae4763e7629b9c258e1ea -> Wandalen/wretry.action@v3.8.0_js_action. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-e2e-badger.yaml"
        },
        "region": {
         "startLine": 55
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/secure-builder-checkout@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/generate-builder@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/secure-builder-checkout@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`slsa-framework/slsa-github-generator/.github/actions/compute-sha256@v2.1.0` (tag) is pulled in transitively via .github/workflows/ci-release.yml -> slsa-framework/slsa-github-generator/.github/workflows/generator_generic_slsa3.yml@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/secure-download-artifact@v2.1.0 -> slsa-framework/slsa-github-generator/.github/actions/compute-sha256@v2.1.0. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/ci-release.yml"
        },
        "region": {
         "startLine": 198
        }
       }
      }
     ]
    }
   ]
  }
 ]
}