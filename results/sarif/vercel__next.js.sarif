{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "actpin",
     "version": "0.1.0",
     "informationUri": "https://github.com/",
     "rules": [
      {
       "id": "APN001",
       "name": "unpinned-direct",
       "shortDescription": {
        "text": "Action reference in this repository is not pinned to a full commit SHA"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN002",
       "name": "unpinned-transitive",
       "shortDescription": {
        "text": "A pinned action or reusable workflow pulls in an unpinned action"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN003",
       "name": "impostor-commit",
       "shortDescription": {
        "text": "Pinned SHA is not reachable from any branch or tag of the upstream repository"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN004",
       "name": "tag-moved",
       "shortDescription": {
        "text": "A referenced tag now points at a different commit"
       },
       "defaultConfiguration": {
        "level": "warning"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`vercel/next.js/.github/actions/pr-auto-label@canary` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/pull_request_auto_label.yml"
        },
        "region": {
         "startLine": 65
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`actions/checkout@v4` (tag) is pulled in transitively via .github/workflows/triage.yml -> balazsorban44/nissuer@92ef22afd6a75e5e588f5d689a1fd3433f596f82 -> actions/checkout@v4. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/triage.yml"
        },
        "region": {
         "startLine": 26
        }
       }
      }
     ]
    }
   ]
  }
 ]
}