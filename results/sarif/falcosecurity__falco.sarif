{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "actpin",
     "version": "0.1.0",
     "informationUri": "https://github.com/",
     "rules": [
      {
       "id": "APN001",
       "name": "unpinned-direct",
       "shortDescription": {
        "text": "Action reference in this repository is not pinned to a full commit SHA"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN002",
       "name": "unpinned-transitive",
       "shortDescription": {
        "text": "A pinned action or reusable workflow pulls in an unpinned action"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN003",
       "name": "impostor-commit",
       "shortDescription": {
        "text": "Pinned SHA is not reachable from any branch or tag of the upstream repository"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN004",
       "name": "tag-moved",
       "shortDescription": {
        "text": "A referenced tag now points at a different commit"
       },
       "defaultConfiguration": {
        "level": "warning"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`falcosecurity/libs/.github/actions/install-zig@master` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/reusable_build_packages.yaml"
        },
        "region": {
         "startLine": 101
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`falcosecurity/libs/.github/actions/install-zig@master` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/reusable_build_packages.yaml"
        },
        "region": {
         "startLine": 174
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`falcosecurity/testing@main` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/reusable_test_packages.yaml"
        },
        "region": {
         "startLine": 72
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`actions/setup-go@v4` (tag) is pulled in transitively via .github/workflows/release.yaml -> ekoops/rn2md@a30974f3c228cbca9409a3bb5b6eb17a2eeb9f71 -> actions/setup-go@v4. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/release.yaml"
        },
        "region": {
         "startLine": 181
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`actions/setup-go@v3` (tag) is pulled in transitively via .github/workflows/reusable_test_packages.yaml -> falcosecurity/testing@main -> actions/setup-go@v3. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/reusable_test_packages.yaml"
        },
        "region": {
         "startLine": 72
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`docker://ghcr.io/ossf/scorecard-action:v2.4.4` (docker-tag) is pulled in transitively via .github/workflows/scorecard.yaml -> ossf/scorecard-action@2d1146689b8cda280b9bc96326124645441f03bc -> docker://ghcr.io/ossf/scorecard-action:v2.4.4. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/scorecard.yaml"
        },
        "region": {
         "startLine": 46
        }
       }
      }
     ]
    }
   ]
  }
 ]
}