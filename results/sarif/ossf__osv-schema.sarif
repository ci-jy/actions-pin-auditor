{
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "version": "2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "actpin",
     "version": "0.1.0",
     "informationUri": "https://github.com/",
     "rules": [
      {
       "id": "APN001",
       "name": "unpinned-direct",
       "shortDescription": {
        "text": "Action reference in this repository is not pinned to a full commit SHA"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN002",
       "name": "unpinned-transitive",
       "shortDescription": {
        "text": "A pinned action or reusable workflow pulls in an unpinned action"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN003",
       "name": "impostor-commit",
       "shortDescription": {
        "text": "Pinned SHA is not reachable from any branch or tag of the upstream repository"
       },
       "defaultConfiguration": {
        "level": "error"
       }
      },
      {
       "id": "APN004",
       "name": "tag-moved",
       "shortDescription": {
        "text": "A referenced tag now points at a different commit"
       },
       "defaultConfiguration": {
        "level": "warning"
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@nightly` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN001",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@nightly` uses a mutable branch reference; pin it to a full SHA."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 50
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/osv-scanner-action@nightly` (branch) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@nightly -> google/osv-scanner-action/osv-scanner-action@nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/osv-reporter-action@nightly` (branch) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@nightly -> google/osv-scanner-action/osv-reporter-action@nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/osv-scanner-action@nightly` (branch) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@nightly -> google/osv-scanner-action/osv-scanner-action@nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 50
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/osv-scanner-action@nightly` (branch) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@nightly -> google/osv-scanner-action/osv-scanner-action@nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 50
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`google/osv-scanner-action/osv-reporter-action@nightly` (branch) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@nightly -> google/osv-scanner-action/osv-reporter-action@nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 50
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`docker://ghcr.io/google/osv-scanner-action:nightly` (docker-tag) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@nightly -> google/osv-scanner-action/osv-scanner-action@nightly -> docker://ghcr.io/google/osv-scanner-action:nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    },
    {
     "ruleId": "APN002",
     "level": "error",
     "message": {
      "text": "`docker://ghcr.io/google/osv-scanner-action:nightly` (docker-tag) is pulled in transitively via .github/workflows/osv-scanner-unified-action.yml -> google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@nightly -> google/osv-scanner-action/osv-reporter-action@nightly -> docker://ghcr.io/google/osv-scanner-action:nightly. Pinning the direct reference does not pin this action."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": ".github/workflows/osv-scanner-unified-action.yml"
        },
        "region": {
         "startLine": 37
        }
       }
      }
     ]
    }
   ]
  }
 ]
}